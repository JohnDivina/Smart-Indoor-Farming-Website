# SmartFarm2 Environment Variables
# Copy this file as reference when setting variables on Railway
# DO NOT commit real credentials to GitHub

# --- Database (set automatically on Railway when you add MySQL service) ---
MYSQLHOST=your-railway-mysql-host
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=your-db-password
MYSQLDATABASE=railway

# --- Optional: OpenWeather API (if used) ---
# OPENWEATHER_API_KEY=your_api_key_here

# --- Gmail SMTP (for OTP emails) ---
# GMAIL_USER=youremail@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
