# ── Supabase PostgreSQL Database ──
# Transaction mode (pgBouncer / Supabase port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# Session / Direct mode (Supabase port 5432) for migrations & schema sync
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ── NextAuth.js Configuration ──
NEXTAUTH_SECRET="replace-with-a-random-secret-key-32-chars-minimum"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth 2.0 ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Gmail SMTP (for OTP Email Verification) ──
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-gmail-16-char-app-password"

# ── OpenWeather API ──
OPENWEATHER_API_KEY=""

# ── Upstash Redis (Rate Limiting) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── ESP32 Hardware Security Key ──
ESP32_API_KEY="smartfarm_esp32_hardware_key_2026"
